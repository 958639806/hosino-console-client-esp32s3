# Extra apps share the proven v4 display configuration.
# Never format a user's card on a failed mount.
# CONFIG_BSP_SD_FORMAT_ON_MOUNT_FAIL is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_FS_LOCK=8
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_USE_KEYBOARD=y
CONFIG_LV_USE_IME_PINYIN=y
CONFIG_LV_IME_PINYIN_USE_DEFAULT_DICT=y
CONFIG_LV_IME_PINYIN_USE_K9_MODE=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Stable hardware touch IDs feed LVGL's single-pointer multi-touch recognizers.
# Brookesia keeps one primary pointer; individual apps opt into pinch events.
CONFIG_LV_USE_FLOAT=y
CONFIG_LV_USE_GESTURE_RECOGNITION=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# UI/media allocations may use PSRAM; preserve contiguous SRAM for LCD,
# SD and I2S DMA plus native task stacks (the v1 4KiB reserve was exhausted).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

# The real Beijing HTTPS stream was receiver-window limited at 5760 bytes.
# Cover about 25KiB BDP at 1.51Mbps/130ms without changing TX/radio clocks.
# Keep existing malloc PSRAM preference, WiFi buffers and BLE coexistence.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=24

# Fonts/images stay flash-mapped; copying all constants into the 8MiB PSRAM
# left too little heap for the console plus video frame/decode buffers.
# Retain code fetch from PSRAM. Flash-writing tasks use internal stacks and
# the LCD SPI interrupt is not registered as cache-safe/IRAM.
# CONFIG_SPIRAM_XIP_FROM_PSRAM is not set
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
# CONFIG_SPIRAM_RODATA is not set

# The console serializes HTTPS requests. Place TLS's variable-sized handshake
# allocations in PSRAM instead of competing with fixed LCD/SD/I2S DMA buffers.
# Keep the certificate bundle, hostname validation and full TLS receive records.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# On-demand BLE observer. Keep host allocations in PSRAM, default radio off in service.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL is not set
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_PINNED_TO_CORE_0=y
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=y
# CONFIG_BT_NIMBLE_EXT_ADV is not set
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ESP Player owns media pipelines; the existing BSP and Brookesia own audio/display.
CONFIG_ESP_PLAYER_ENABLE_AUDIO=y
CONFIG_ESP_PLAYER_ENABLE_VIDEO=y
CONFIG_ESP_PLAYER_ENABLE_FILE_IO=y
CONFIG_ESP_PLAYER_ENABLE_HTTP_IO=y
# CONFIG_ESP_PLAYER_ENABLE_HLS_IO is not set
# CONFIG_ESP_VIDEO_RENDER_LVGL_BACKEND_SUPPORT is not set
# CONFIG_ESP_VIDEO_RENDER_TEXT_WIDGET_SUPPORT is not set

# The video app accepts MJPEG AVI. H.264's unused decoder consumes shared
# internal IRAM/DRAM needed to create the media render task.
# CONFIG_VIDEO_DECODER_SW_H264_SUPPORT is not set
